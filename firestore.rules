rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Decision 11: collection live/{deviceId} holds latest point only
    match /live/{deviceId} {
      // Anyone authenticated (anonymous sign-in ok) can read active vehicle positions
      allow read: if request.auth != null;

      // Authenticated users can write only their own live document
      // Validates presence of lat, lng, ts, routeId, source and checks that ts is not
      // more than 5 minutes into the future.
      allow write: if request.auth != null
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && request.resource.data.ts is string
        && request.resource.data.routeId is string
        && request.resource.data.source in ['driver', 'passenger']
        && request.resource.data.ttl is string
        && timestamp.date(
             int(request.resource.data.ts[0:4]),
             int(request.resource.data.ts[5:7]),
             int(request.resource.data.ts[8:10])
           ) <= request.time + duration.value(5, 'm');
    }
  }
}
